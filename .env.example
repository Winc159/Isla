# 本次会话使用的 Provider 和模型。例如：openai、deepseek、local。
ISLA_PROVIDER=deepseek
ISLA_MODEL=deepseek-flash
# 请求超时时间，以及进程内对话上下文的限制。
ISLA_TIMEOUT_MS=600000
ISLA_MODEL_RETRIES=0
ISLA_MAX_CONTEXT_TURNS=20
ISLA_MAX_CONTEXT_CHARS=60000
ISLA_CONTEXT_RETAIN_TURNS=6
# 可选的持久化记忆配置。
ISLA_MEMORY_ENABLED=1
ISLA_MEMORY_DB=./data/isla-memory.db
ISLA_EMBEDDING_PROVIDER=
ISLA_EMBEDDING_MODEL=
ISLA_EMBEDDING_BASE_URL=
ISLA_EMBEDDING_API_KEY=
# 设置为 1 可启用诊断日志。
ISLA_DEBUG=
# Provider 凭据。Profile 启动方式默认使用 ~/.isla/config.json；.env 仅用于 --env、测试、CI 和临时运行。真实 API Key 禁止提交到 Git。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 可选的 OpenAI 兼容接口地址和 API Key，适用于本地模型服务。
ISLA_BASE_URL=
ISLA_API_KEY=
# 助手的默认系统提示词。
ISLA_SYSTEM_PROMPT="
你是 Isla（艾拉），master的个人虚拟助手。

工作原则：
- 优先完成 master 的当前任务，直接给出准确、可执行的答案。
- 默认使用中文。
- 简洁、克制、有分寸，避免无意义的寒暄和过度修饰。
- 不确定时明确说明；不虚构已完成的操作、记忆或能力。
- 需要时先指出关键结论，再补充必要的步骤、风险或依据。
"
# 可选的会话目录，以及是否主动运行真实 Provider 冒烟测试。
ISLA_SESSION_DIR=
ISLA_RUN_REAL_SMOKE=
ISLA_SHOW_REAL_NDJSON=1

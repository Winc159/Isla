{
  "name": "@winc159/isla",
  "version": "0.2.6.1",
  "private": true,
  "type": "module",
  "bin": {
    "isla": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke",
    "test:smoke:real": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/smoke/real-provider.test.ts",
    "test:smoke:real:ndjson": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/smoke/real-ndjson.test.ts",
    "test:protocol": "vitest run tests/protocol.test.ts",
    "check": "npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "openai": "^5.12.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "msw": "^2.10.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

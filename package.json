{
  "name": "@winc159/isla",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "bin": {
    "isla": "dist/entrypoints/cli.js",
    "isla-host": "dist/entrypoints/host.js",
    "isla-resource": "dist/entrypoints/resource.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/entrypoints/cli.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node node_modules/vite/bin/vite.js build --config resource-ui/vite.config.ts && node node_modules/vite/bin/vite.js build --config agent-ui/vite.config.ts && node scripts/mark-entrypoints-executable.mjs",
    "resource:ui:build": "node node_modules/vite/bin/vite.js build --config resource-ui/vite.config.ts",
    "agent:ui:build": "node node_modules/vite/bin/vite.js build --config agent-ui/vite.config.ts",
    "install:browser": "node scripts/install-browser.mjs",
    "install:deps": "node scripts/install-dependencies.mjs",
    "install:all": "node scripts/install-all.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:bdpan": "node scripts/install-bdpan.mjs",
    "resource:bdpan": "node scripts/bdpan-runner.mjs",
    "resource:start": "node dist/entrypoints/resource.js",
    "host:start": "node dist/entrypoints/host.js",
    "test:archive:fixtures": "node scripts/create-archive-fixtures.mjs",
    "setup:browser": "npm install && npm run install:browser",
    "setup": "npm install && npm run install:all && npm run build && npm link",
    "start": "node --env-file-if-exists=.env dist/entrypoints/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/pty/**",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke",
    "test:smoke:mcp": "node scripts/run-mcp-eval.mjs",
    "verify": "node scripts/verify.mjs",
    "test:smoke:real": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/smoke/real-provider.test.ts",
    "test:smoke:real:ndjson": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/smoke/real-ndjson.test.ts",
    "test:protocol": "vitest run tests/protocol.test.ts",
    "test:pty": "npm run build && vitest run tests/pty tests/support/pty-driver.test.ts --pool=forks",
    "check": "npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@vscode/ripgrep": "^1.18.0",
    "ipaddr.js": "^2.5.0",
    "openai": "^5.12.2",
    "playwright": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^24.0.0",
    "msw": "^2.10.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
